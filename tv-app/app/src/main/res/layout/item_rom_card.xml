<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@color/card"
    android:layout_margin="8dp" android:padding="16dp"
    android:focusable="true" android:clickable="true">
    <!-- Game art placeholder (no copyrighted box art bundled). -->
    <View
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="4"
        android:background="@drawable/art_placeholder" />
    <TextView
        android:id="@+id/rom_title"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="2"
        android:gravity="bottom"
        android:textColor="@color/ink" android:textSize="15sp"
        android:maxLines="2" android:ellipsize="end" android:layout_marginTop="8dp" />
    <TextView
        android:id="@+id/rom_system"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="2dp" />
</LinearLayout>
