<?xml version="1.0" encoding="utf-8"?>
<!-- ROM library card: poster art (user-provided local image, else placeholder), title, system. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="8dp"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/rom_poster"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:contentDescription="Game cover"
        android:src="@drawable/art_placeholder" />

    <TextView
        android:id="@+id/rom_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Game" />

    <TextView
        android:id="@+id/rom_system"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/muted"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="System" />
</LinearLayout>
