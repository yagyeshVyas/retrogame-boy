<?xml version="1.0" encoding="utf-8"?>
<!-- Placeholder art for ROM cards. No copyrighted game art is bundled. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1B1B25" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:gravity="center">
        <shape android:shape="rectangle" android:width="40dp" android:height="26dp">
            <solid android:color="#A13BFF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- little d-pad cross -->
    <item android:gravity="center" android:top="0dp">
        <shape android:shape="rectangle" android:width="10dp" android:height="10dp">
            <solid android:color="#22D3EE" />
        </shape>
    </item>
</layer-list>
