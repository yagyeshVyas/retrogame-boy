# Android / Gradle
tv-app/.gradle/
tv-app/build/
tv-app/**/build/
tv-app/local.properties
*.apk
*.aab

# Flutter / Dart
controller-app/.dart_tool/
controller-app/.flutter-plugins*
controller-app/build/
controller-app/.packages
controller-app/.pub-cache/
*.iml

# iOS
controller-app/ios/Pods/
controller-app/ios/.symlinks/
*.ipa

# Node (tools)
tools/node_modules/
tools/package-lock.json

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# NEVER commit ROMs
*.nes
*.snes
*.smc
*.gb
*.gbc
*.gba
*.gen
*.n64
*.z64
*.v64
*.iso
*.cue
*.chd
*.zip

# keep local ROMs out of git too (user-owned files)
user-roms/

# Local build artifacts (APKs) — keep built binaries out of git
# (dist/ios/*.md and *.sh docs ARE tracked)
dist/*.apk
dist/*.aab
# local build env (machine-specific paths)
env.sh
release-assets/

# Vendored libretro core binaries (large GPL .so) — fetched via scripts/fetch-cores.sh
controller-app/../tv-app/app/src/main/jniLibs/
tv-app/app/src/main/jniLibs/

# Native build intermediates
controller-app/android/.cxx/
controller-app/android/app/.cxx/
controller-app/android/.gradle/
tv-app/app/.cxx/
tv-app/app/build/
tv-app/.gradle/
test-roms/

# Signing secrets — NEVER commit
tv-app/../keystore/
keystore/
*.keystore
*.jks
